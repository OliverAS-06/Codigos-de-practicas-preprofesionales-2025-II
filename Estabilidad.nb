Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "a_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "6"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"A", "+", 
        RowBox[{"B", " ", 
         SuperscriptBox["a", 
          RowBox[{
           RowBox[{"-", "3"}], "-", 
           RowBox[{"3", " ", "\[Alpha]"}]}]]}]}], ")"}], 
      FractionBox["1", 
       RowBox[{"1", "+", "\[Alpha]"}]]], " ", 
     SuperscriptBox["a", "2"]}], "+", 
    FractionBox["\[Kappa]", "2"]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "la", " ", "funci\[OAcute]n", " ", "A", " ", "con", " ", 
    "un", " ", "parametro", " ", "\[Alpha]"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"a_", ",", "\[Alpha]_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"3", " ", "\[Kappa]"}], 
        SuperscriptBox["a", "2"]], ")"}], 
      RowBox[{"1", "+", "\[Alpha]"}]], "-", 
     FractionBox["B", 
      SuperscriptBox["a", 
       RowBox[{"3", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Parameter", " ", "values"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Kappa]", "=", 
   RowBox[{"+", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]List", "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.7", ",", "0.9", ",", "1.0"}], "}"}]}], ";"}], 
  "  ", 
  RowBox[{"(*", 
   RowBox[{"your", " ", "\[Alpha]", " ", "values"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "=", "1"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Grafica", " ", "para", " ", "las", " ", "curvas", " ", "de", " ", 
    "\[Alpha]"}], "*)"}]}], "\[IndentingNewLine]", 
