Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "la", " ", "funci\[OAcute]n", " ", "A", " ", "con", " ", 
    "un", " ", "parametro", " ", "\[Alpha]"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"a_", ",", "\[Alpha]_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"3", " ", "\[Kappa]"}], 
        SuperscriptBox["a", "2"]], ")"}], 
      RowBox[{"1", "+", "\[Alpha]"}]], "-", 
     FractionBox["B", 
      SuperscriptBox["a", 
       RowBox[{"3", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Parameter", " ", "values"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Kappa]", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]List", "=", 
    RowBox[{"{", 
     RowBox[{"0.1", ",", "0.4", ",", "0.7", ",", "1"}], "}"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"your", " ", "\[Alpha]", " ", "values"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "=", 
    RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Grafica", " ", "para", " ", "las", " ", "curvas", " ", "de", " ", 
    "\[Alpha]"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"a", ",", "\[Alpha]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Alpha]List"}], "}"}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0.1", ",", "0.6"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{
     RowBox[{"ColorData", "[", "97", "]"}], "/@", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "\[Alpha]List", "]"}], "]"}]}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
