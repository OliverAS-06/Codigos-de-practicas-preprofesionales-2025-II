      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "\[Alpha]List", "]"}], "]"}]}], ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<\[Alpha] = \>\"", "<>", 
