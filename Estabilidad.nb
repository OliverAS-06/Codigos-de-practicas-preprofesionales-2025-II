Cell[TextData[{
 "Introducimos la nueva variable temporal \[Tau] como una funci\[OAcute]n \
monotoma del tiempo cosmol\[OAcute]gico original ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d\[Tau]", "dt"], "=", 
    FractionBox["1", 
     SuperscriptBox["\[Rho]", "\[Alpha]"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "971720d3-709e-4835-995e-1ca8e31a7c72"],
 "\[DoubleRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d", "d\[Tau]"], "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d6b4317-4906-4ee1-a68f-f130b22fb452"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Rho]", "\[Alpha]"], 
    FractionBox["d", "dt"]}], TraditionalForm]],ExpressionUUID->
  "0f89c885-19b6-46b8-95cf-faaf7f3c064f"]
}], "Text",
