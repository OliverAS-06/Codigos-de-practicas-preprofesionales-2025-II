              " ", 
              RowBox[{"LegendMarkerSize", "->", 
               RowBox[{"{", 
                RowBox[{"10", ",", "5"}], "}"}]}]}], "]"}], "}"}], "]"}], ",",
           " ", 
          RowBox[{"RoundingRadius", "->", "2"}]}], "]"}], ",", " ", 
