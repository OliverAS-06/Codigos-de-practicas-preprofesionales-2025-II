 "= ",
 Cell[BoxData[
  FormBox[
   FractionBox["k", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86b41ff8-6cfd-4703-bf96-e56cc99ae26e"],
 ". Obtenemos el potencial del sistema en la siguiente forma:"
}], "Text",
 CellChangeTimes->{{3.9635993264854355`*^9, 3.9635993355604215`*^9}, {
  3.9635994209683533`*^9, 3.9635994546156497`*^9}, {3.9635994890429015`*^9, 
