Cell[TextData[{
 "Vamos a considerar el modelo de FRW con el termino de \[CapitalLambda] \
nulo, es decir:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["dH", "dt"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", 
       SuperscriptBox["H", "2"]}], "-", " ", 
      RowBox[{
       FractionBox["1", "6"], 
       RowBox[{"(", 
        RowBox[{"\[Rho]", "+", 
         RowBox[{"3", "p"}]}], ")"}]}]}], "=", 
     RowBox[{"P", "(", 
      RowBox[{"H", ",", "\[Rho]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"54865458-008f-453d-acdd-147e5145310f"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d\[Rho]", "dt"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "3"}], 
      RowBox[{"H", "(", 
       RowBox[{"\[Rho]", "+", "p"}], ")"}]}], "=", 
     RowBox[{"Q", "(", 
      RowBox[{"H", ",", "\[Rho]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"18652249-9de7-4797-94a6-136ee91b6ed8"]
}], "Text",
 CellChangeTimes->{{3.963331253069316*^9, 3.9633313396994104`*^9}, {
  3.963331374106014*^9, 3.963331382371135*^9}, {3.9633317682614555`*^9, 
  3.963331910778099*^9}, {3.963332582934903*^9, 3.963332594059538*^9}},
 TextAlignment->Center,
 TextJustification->1.,ExpressionUUID->"e0fcd8e9-b7d8-4d47-8e7d-8ef1f46b0f50"],

Cell["que est\[AAcute]n representadas por el siguiente c\[OAcute]digo:", \
"Text",
 CellChangeTimes->{{3.9633326023122444`*^9, 
  3.9633326144921093`*^9}},ExpressionUUID->"08635c76-38f3-4ddc-8077-\
3d46c16fed6d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FieldEq0", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "'"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"H", "[", "t", "]"}], "2"]}], "-", 
     RowBox[{
      FractionBox["1", "6"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Rho]", "[", "t", "]"}], "+", 
        RowBox[{"3", 
         RowBox[{"P", "[", "t", "]"}]}]}], ")"}]}]}]}]}], 
  ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{"FieldEq1", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"-", "3"}], 
      RowBox[{"H", "[", "t", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Rho]", "[", "t", "]"}], "+", 
        RowBox[{"P", "[", "t", "]"}]}], ")"}]}]}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"ecuaci\[OAcute]n", " ", "de", " ", "continuidad"}], 
   "*)"}]}]}], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.963343851933795*^9, 3.96334386135007*^9}},
 CellLabel->
  "In[968]:=",ExpressionUUID->"8bcab094-48e7-445c-b1a8-a4192bf75592"],

Cell["\<\
La ecuaci\[OAcute]n de estado por la generalizaci\[OAcute]n del gas de \
Chaplygin de abajo, donde A>0 y 0<\[Alpha]\[LessEqual]1\
\>", "Text",
 CellChangeTimes->{{3.9633327635716753`*^9, 3.963332782726301*^9}, {
  3.9633330951213655`*^9, 
  3.96333313726711*^9}},ExpressionUUID->"bc63cba2-374a-4b51-908c-\
0f7007fc4937"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Eq1", "=", 
   RowBox[{
    RowBox[{"P", "[", "t", "]"}], "==", 
    RowBox[{"-", 
     FractionBox["A", 
      SuperscriptBox[
       RowBox[{"\[Rho]", "[", "t", "]"}], "\[Alpha]"]]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.963332788858491*^9, 3.9633327986921587`*^9}, {
  3.9633329015910177`*^9, 3.9633329215313187`*^9}, {3.963335255987142*^9, 
  3.9633352996018066`*^9}, {3.9633383728780823`*^9, 3.9633383750409737`*^9}, {
  3.96333884887035*^9, 3.9633388518336277`*^9}, {3.963338916950473*^9, 
  3.9633389179896216`*^9}},
 CellLabel->
  "In[970]:=",ExpressionUUID->"86136306-36a0-4b37-bf27-28434a5eaf67"],

Cell[CellGroupData[{

Cell["Matriz", "Subsection",
 CellChangeTimes->{{3.960258280417667*^9, 3.960258285277178*^9}, {
  3.9633333446668572`*^9, 
  3.963333352156333*^9}},ExpressionUUID->"233f1188-2cb9-429d-a84f-\
bbb935203694"],

Cell[TextData[{
 "Los puntos criticos del espacio de fase, est\[AAcute]n dados por la matriz \
linealizada ",
 Cell[BoxData[
