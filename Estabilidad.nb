Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Parameter", " ", 
    RowBox[{"sets", ":", 
     RowBox[{"{", 
      RowBox[{
      "\[CapitalOmega]_m", ",", "\[CapitalOmega]_Chapl", ",", "\[Alpha]", ",",
        "As"}], "}"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"paramsList", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.95", ",", "0.51", ",", "0.73"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Model", " ", "1"}], ":", 
       RowBox[{"Chaplygin", " ", "gas"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"0.3", ",", "0.7", ",", "0.95", ",", "0.05"}], "}"}]}], "    ", 
    RowBox[{"(*", 
     RowBox[{"Reference", ":", "\[CapitalLambda]CDM"}], "*)"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"H0", "=", "67"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"km", "/", "s"}], "/", "Mpc"}], "*)"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Function", " ", "to", " ", "get", " ", "H", 
     RowBox[{"(", "z", ")"}], " ", "for", " ", "a", " ", "given", " ", 
     "\[CapitalOmega]_m"}], ",", "\[CapitalOmega]_Chapl", ",", "\[Alpha]", 
    ",", "As"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HzFunc", "[", 
      RowBox[{
      "\[CapitalOmega]m_", ",", "\[CapitalOmega]Ch_", ",", "\[Alpha]_", ",", 
       "As_"}], "]"}], "[", "z_", "]"}], ":=", 
    RowBox[{"H0", 
     SqrtBox[
      RowBox[{
       RowBox[{"\[CapitalOmega]m", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
       RowBox[{"\[CapitalOmega]Ch", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"As", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "As"}], ")"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", "z"}], ")"}], 
             RowBox[{"3", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]}]}], ")"}], 
         FractionBox["1", 
          RowBox[{"1", "+", "\[Alpha]"}]]]}]}]]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Resolvemos", " ", "la", " ", "ED", " ", "para", " ", "D_L", 
     RowBox[{"(", "z", ")"}], " ", "dados", " ", "los", " ", "valores", " ", 
     "de", " ", "\[CapitalOmega]_m"}], ",", "\[CapitalOmega]_Chapl", ",", 
    "\[Alpha]", ",", "As"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"solveDL", "[", 
     RowBox[{
     "\[CapitalOmega]m_", ",", "\[CapitalOmega]Ch_", ",", "\[Alpha]_", ",", 
      "As_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Hz", ",", "sol"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Hz", "=", 
        RowBox[{"HzFunc", "[", 
         RowBox[{
         "\[CapitalOmega]m", ",", "\[CapitalOmega]Ch", ",", "\[Alpha]", ",", 
          "As"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{
                RowBox[{"DL", "'"}], "[", "z", "]"}], 
               RowBox[{"1", "+", "z"}]], "-", 
              FractionBox[
               RowBox[{"DL", "[", "z", "]"}], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "+", "z"}], ")"}], "2"]], "-", 
              FractionBox["1", 
               RowBox[{"Hz", "[", "z", "]"}]]}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"DL", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "DL", 
          ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", "2.5"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"First", "[", 
        RowBox[{"DL", "/.", " ", "sol"}], "]"}]}]}], "  ", 
     RowBox[{"(*", 
      RowBox[{"Interpolating", " ", "function"}], "*)"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Distance", " ", "modulus", " ", "function"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"muFromDL", "[", "DLif_", "]"}], ":=", 
    RowBox[{"Function", "[", 
     RowBox[{"z", ",", 
      RowBox[{
       RowBox[{"5", " ", 
        RowBox[{"Log10", "[", 
         RowBox[{"DLif", "[", "z", "]"}], "]"}]}], "+", "25"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Solve", " ", "for", " ", "both", " ", "models", " ", "using", " ", 
    "parameters", " ", "from", " ", "the", " ", "list"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DLModel1", "=", 
   RowBox[{"solveDL", "@@", 
    RowBox[{"paramsList", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DLRef", "=", 
    RowBox[{"solveDL", "@@", 
     RowBox[{"paramsList", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"muModel1", "=", 
   RowBox[{"muFromDL", "[", "DLModel1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"muRef", "=", 
    RowBox[{"muFromDL", "[", "DLRef", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"\[CapitalDelta]m_eff", " ", "function"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"deltaMeff", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"muModel1", "[", "z", "]"}], "-", 
     RowBox[{"muRef", "[", "z", "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", " ", "\[CapitalDelta]m_eff", " ", "with", " ", "log"}], 
    "-", 
    RowBox[{"scale", " ", "on", " ", "z"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListLogLinearPlot", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{"deltaMeff", "[", "z", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0.01", ",", "2.5", ",", "0.01"}], "}"}]}], "]"}], 
    ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<z\>\"", ",", "Bold", ",", "Large"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
        "\"\<\[CapitalDelta]m_eff(z)\>\"", ",", "Bold", ",", "Large"}], 
        "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotStyle", "->", "Thick"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.01", ",", "2.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 
    RowBox[{"ImageSize", "->", "700"}], ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\< gr\[AAcute]fico de residuos de la relaci\[OAcute]n desplazamiento \
al rojo-magnitud para los datos de supernovas\>\""}]}], "]"}], 
  "\n"}], "\n"}], "Input",
