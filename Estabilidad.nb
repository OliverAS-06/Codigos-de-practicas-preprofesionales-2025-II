16fa2ec1f6bf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "a_", "]"}], ":=", 
   FractionBox["a", 
    SubscriptBox["a", "0"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{
      RowBox[{"x", "'"}], "[", "a", "]"}], "2"], "2"], "==", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["\[CapitalOmega]", 
      RowBox[{"k", ",", "0"}]]}], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["\[CapitalOmega]", 
      RowBox[{"Chapl", ",", "0"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["A", "s"], "+", 
        FractionBox[
         RowBox[{"1", "-", 
          SubscriptBox["A", "s"]}], 
         SuperscriptBox[
          RowBox[{"x", "[", "a", "]"}], 
          RowBox[{"3", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]]}], ")"}], 
      FractionBox["1", 
       RowBox[{"1", "+", "\[Alpha]"}]]], 
     SuperscriptBox[
      RowBox[{"x", "[", "a", "]"}], "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SubscriptBox["\[CapitalOmega]", 
      RowBox[{"k", ",", "0"}]]}], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["\[CapitalOmega]", 
      RowBox[{"Chapl", ",", "0"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["A", "s"], "+", 
        FractionBox[
         RowBox[{"1", "-", 
          SubscriptBox["A", "s"]}], 
         SuperscriptBox["x", 
          RowBox[{"3", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]]}], ")"}], 
      FractionBox["1", 
       RowBox[{"1", "+", "\[Alpha]"}]]], 
     SuperscriptBox["x", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xpp", "=", 
   RowBox[{"-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"V", "[", "x", "]"}], ",", "x"}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Esto", " ", "es", " ", 
      RowBox[{"x", "''"}]}], "=", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{"V", ",", "x"}], "]"}]}]}], ",", " ", 
    RowBox[{
    "esta", " ", "es", " ", "la", " ", "ecuaci\[OAcute]n", " ", "31"}]}], 
   "*)"}]}], "\n"}], "Input",
