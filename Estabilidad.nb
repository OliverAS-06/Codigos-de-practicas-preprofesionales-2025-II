Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Parametros", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalOmega]", 
      RowBox[{"m", ",", "0"}]], "=", "0.05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalOmega]", 
      RowBox[{"Chapl", ",", "0"}]], "=", "0.95"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", "0.51"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     SubscriptBox["A", "s"], "=", "0.73"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     SubscriptBox["H", "0"], "=", "67.11"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Funci\[OAcute]n", " ", "de", " ", "Hubble", " ", "H", 
     RowBox[{"(", "z", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Hz", "[", "z_", "]"}], ":=", 
    RowBox[{
     SubscriptBox["H", "0"], 
     SqrtBox[
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalOmega]", 
         RowBox[{"m", ",", "0"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
       RowBox[{
        SubscriptBox["\[CapitalOmega]", 
         RowBox[{"Chapl", ",", "0"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["A", "s"], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              SubscriptBox["A", "s"]}], ")"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", "z"}], ")"}], 
             RowBox[{"3", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]}]}], ")"}], 
         FractionBox["1", 
          RowBox[{"1", "+", "\[Alpha]"}]]]}]}]]}]}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "ODE", " ", "for", " ", "D_L", 
     RowBox[{"(", "z", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol\[CurlyRho]Models", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"DL", "'"}], "[", "z", "]"}], 
            RowBox[{"1", "+", "z"}]], "-", 
           FractionBox[
            RowBox[{"DL", "[", "z", "]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", "z"}], ")"}], "2"]], "-", 
           FractionBox["1", 
            RowBox[{"Hz", "[", "z", "]"}]]}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"DL", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "DL", ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Mu]DLModels", "[", "z_", "]"}], ":=", 
     RowBox[{
      RowBox[{"5", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"10", ",", " ", 
         RowBox[{"DL", "[", "z", "]"}]}], "]"}]}], "+", "25"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "result"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"DL", "[", "z", "]"}], "/.", " ", "sol\[CurlyRho]Models"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<z\>\"", ",", "\"\<D_L(z) [Mpc]\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Distancia luminosa para el gas de Chaplygin\>\""}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"\[Mu]DLModels", "[", "z", "]"}], "/.", " ", 
        "sol\[CurlyRho]Models"}], "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "2.5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", "Blue", "}"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Frame", "->", "True"}], ",", " ", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<z\>\"", ",", " ", "Bold", ",", " ", "Large"}], "]"}], 
        ",", " ", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\[Mu](z)\>\"", ",", " ", "Bold", ",", " ", "Large"}], 
         "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"FrameTicksStyle", "->", "Large"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Epilog", "->", 
      RowBox[{"Inset", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Framed", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{"LineLegend", "[", 
             RowBox[{
              RowBox[{"{", "Blue", "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[Mu](z)\>\"", ",", "20"}], "]"}], "}"}], ",", 
              " ", 
              RowBox[{"LegendMarkerSize", "->", 
               RowBox[{"{", 
                RowBox[{"10", ",", "5"}], "}"}]}]}], "]"}], "}"}], "]"}], ",",
           " ", 
          RowBox[{"RoundingRadius", "->", "2"}]}], "]"}], ",", " ", 
        RowBox[{"Scaled", "[", 
         RowBox[{"{", 
          RowBox[{"0.7", ",", "0.6"}], "}"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Comparaci\[OAcute]n de la distancia de luminosidad\>\""}], ",", 
     RowBox[{"ImageSize", "->", "700"}]}], "]"}], "\[IndentingNewLine]", 
   "\n"}]}]], "Input",
