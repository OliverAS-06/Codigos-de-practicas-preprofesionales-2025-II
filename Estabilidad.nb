Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "la", " ", "funci\[OAcute]n", " ", "A", " ", "con", " ", 
    "un", " ", "parametro", " ", "B"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"a_", ",", "B_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"3", " ", "\[Kappa]"}], 
        SuperscriptBox["a", "2"]], ")"}], 
      RowBox[{"1", "+", "\[Alpha]"}]], "-", 
     FractionBox["B", 
      SuperscriptBox["a", 
       RowBox[{"3", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Parameter", " ", "values"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Kappa]", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "=", "1"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"your", " ", "\[Alpha]", " ", "values"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BList", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "2.5"}], ",", 
      RowBox[{"-", "5"}], ",", 
      RowBox[{"-", "10"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Grafica", " ", "para", " ", "las", " ", "curvas", " ", "de", " ", 
    "\[Alpha]"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"a", ",", "B"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"B", ",", "BList"}], "}"}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0.4", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{
     RowBox[{"ColorData", "[", "97", "]"}], "/@", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "BList", "]"}], "]"}]}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<a\>\"", ",", "Bold", ",", "Large"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<A\>\"", ",", "Bold", ",", "Large"}], "]"}]}], "}"}]}], 
   ",", 
   RowBox[{"FrameTicksStyle", "->", "Large"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "BList", "]"}], "]"}]}], ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<B = \>\"", "<>", 
              RowBox[{"ToString", "[", "#", "]"}]}], ",", "16"}], "]"}], 
           "&"}], "/@", "BList"}], ")"}], ",", 
        RowBox[{"LegendLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Valores de B\>\"", ",", "Bold", ",", "16"}], "]"}]}]}],
        "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.8", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "20"}], ",", "120"}], "}"}]}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<Modelo cl\[AAcute]sico de A con funci\[OAcute]n potencial\>\""}], 
   ",", 
   RowBox[{"ImageSize", "->", "700"}]}], "]"}]}], "Input",
