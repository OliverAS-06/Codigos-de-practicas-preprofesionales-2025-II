Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "el", " ", "cambio", " ", "de", " ", "variable"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"d\[Tau]", "[", "f_", "]"}], ":=", 
     RowBox[{
      SuperscriptBox["\[Rho]", "\[Alpha]"], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", "t", "]"}], ",", "t"}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "f", " ", "es", " ", "una", " ", "funci\[OAcute]n", " ", "cualquiera"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Segunda", " ", "ecuaci\[OAcute]n", " ", "de", " ", "Friedmann"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"friedmann2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"H", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"H", "[", "t", "]"}], "2"]}], "-", 
       RowBox[{
        FractionBox["1", "6"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]", "[", "t", "]"}], "+", 
          RowBox[{"3", 
           RowBox[{"P", "[", "t", "]"}]}]}], ")"}]}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Ecuaci\[OAcute]n", " ", "de", " ", "Continuidad"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Continuidad", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"-", "3"}], 
       RowBox[{"H", "[", "t", "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Rho]", "[", "t", "]"}], "+", 
         RowBox[{"P", "[", "t", "]"}]}], ")"}]}]}]}], ";"}], " ", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Reemplazamos", " ", 
     RowBox[{
      RowBox[{"H", "'"}], "[", "t", "]"}], " ", "con", " ", 
     FormBox[
      FractionBox["dH", "d\[Tau]"],
      TraditionalForm], " ", "usando", " ", "la", " ", "regla", " ", "de", 
     " ", "la", " ", "cadena"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"friedmann2\[Tau]", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"d\[Tau]", "[", "H", "]"}], "==", 
      RowBox[{
       SuperscriptBox["\[Rho]", "\[Alpha]"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"H", "[", "t", "]"}], "2"]}], "-", 
         RowBox[{
          FractionBox["1", "6"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Rho]", "[", "t", "]"}], "+", 
            RowBox[{"3", 
             RowBox[{"P", "[", "t", "]"}]}]}], ")"}]}]}], ")"}]}]}], "/.", 
     "rules"}]}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Ecuaci\[OAcute]n", " ", "20", "a"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Reemplazamos", " ", 
     RowBox[{
      RowBox[{"\[Rho]", "'"}], "[", "t", "]"}], " ", "con", " ", 
     FormBox[
      FractionBox["d\[Rho]", "d\[Tau]"],
      TraditionalForm], " ", "usando", " ", "la", " ", "regla", " ", "de", 
     " ", "la", " ", "cadena"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Continuidad2\[Tau]", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"d\[Tau]", "[", "\[Rho]", "]"}], "==", 
      RowBox[{
       SuperscriptBox["\[Rho]", "\[Alpha]"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], 
         RowBox[{"H", "[", "t", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Rho]", "[", "t", "]"}], "+", 
           RowBox[{"P", "[", "t", "]"}]}], ")"}]}], ")"}]}]}], "/.", 
     "rules"}]}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Ecuaci\[OAcute]n", " ", "20", "b"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9634899238021717`*^9, 3.9634899609794207`*^9}, {
