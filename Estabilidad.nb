Cell[CellGroupData[{

Cell["\<\
V.  LA RELACI\[CapitalOAcute]N DESPLAZAMIENTO AL ROJO-MAGNITUD PARA EL MODELO \
CON GAS CHAPLYGIN\
\>", "Subsection",
 CellChangeTimes->{{3.9636568867433987`*^9, 
  3.9636569060187607`*^9}},ExpressionUUID->"44e1592a-3b14-49b6-b66e-\
8ae42f46d4d9"],

Cell[TextData[{
 "\tUna relaci\[OAcute]n del desplazamiento al rojo-magnitud puede utilizarse \
para determinar el mejor par\[AAcute]metro para el modelo de FRW con un gas \
de Chaplygin generalizado.\n\tl: es la luminosidad aparente de la fuente \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "L"], ":"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3472874d-4c0a-4d6b-af31-bc7c580462ae"],
 " es la distancia luminosa de la fuente "
}], "Text",
 CellChangeTimes->{{3.9636569435331306`*^9, 3.963657025185258*^9}, {
  3.963657445689493*^9, 3.963657451907873*^9}, {3.963660034925233*^9, 
  3.963660094874399*^9}},ExpressionUUID->"66516adb-36f5-49b5-a633-\
c8de1f16a08d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["d", "L"], "==", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "z"}], ")"}], 
    SubscriptBox["a", "0"], 
    SubscriptBox["r", "1"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", 
   FractionBox["L", 
    RowBox[{"4", " ", "\[Pi]", " ", 
     SubsuperscriptBox["d", "L", "2"]}]]}], ";"}]}], "Input",
 CellLabel->
  "In[1034]:=",ExpressionUUID->"f3c0fbbc-7e57-4272-8c78-c6aa9344ac1d"],

Cell[CellGroupData[{

Cell["La forma integral", "Subsubsection",
 CellChangeTimes->{{3.963674643735718*^9, 
  3.9636746480254264`*^9}},ExpressionUUID->"17ce20d0-a988-49ad-9af4-\
2dd3ed0567a2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     RowBox[{"m", ",", "0"}]], "=", "0.05"}], ";"}], "             ", 
  RowBox[{"(*", 
   RowBox[{"Densidad", " ", "de", " ", "materia"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     RowBox[{"Chapl", ",", "0"}]], "=", "0.95"}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{
   "Densidad", " ", "del", " ", "gas", " ", "de", " ", "Chaplygin", " ", 
    "generalizado"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]", "=", "0.51"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   SubscriptBox["A", "s"], "=", "0.73"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["H", "0"], "=", "70"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Example", " ", "value", " ", "in", " ", 
    RowBox[{
     RowBox[{"km", "/", "s"}], "/", "Mpc"}]}], "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dL", "[", "z_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "+", "z"}], 
     SubscriptBox["H", "0"]], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalOmega]", 
           RowBox[{"m", ",", "0"}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "r"}], ")"}], "3"]}], "+", 
         RowBox[{
          SubscriptBox["\[CapitalOmega]", 
           RowBox[{"Chapl", ",", "0"}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["A", "s"], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SubscriptBox["A", "s"]}], ")"}], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "+", "z"}], ")"}], 
               RowBox[{"3", 
                RowBox[{"(", 
                 RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]}]}], ")"}], 
           FractionBox["1", 
            RowBox[{"1", "+", "\[Alpha]"}]]]}]}]]], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "z"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"dL", "[", "z", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "3"}], "}"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", "\"\<d_L(z) [Mpc]\>\""}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\<Distancia luminosa para el gas de Chaplygin\>\""}]}], "]"}], 
  "\[IndentingNewLine]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9636616461849933`*^9, 3.963661660064583*^9}, {
   3.9636667068373775`*^9, 3.9636667251105947`*^9}, {3.9636667592249546`*^9, 
   3.96366677937842*^9}, 3.963666861906439*^9, {3.9636677433296824`*^9, 
