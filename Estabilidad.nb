Cell[TextData[{
 "Si consideramos la funci\[OAcute]n hamiltoniana ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalH]", "=", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"a", "'"}], ")"}], "2"], "2"], "+", 
     RowBox[{"V", "(", "a", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8653cea1-3d44-4064-badc-b1f6903c42f7"],
 ". Es \[UAcute]til considerar la dinamica en los niveles de energ\[IAcute]a \
igual a cero \[ScriptCapitalH]=E=0. Entonces tenemos ",
 Cell[BoxData[
  SubscriptBox["V", "0"]],
  CellChangeTimes->{
